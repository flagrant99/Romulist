<romulist>
	<folder name="nes Retroarch core fceumm_libretro_android.so" extensions="zip">
		  <intent packageName="com.retroarch.aarch64" packageName32="com.retroarch.ra32" className="com.retroarch.browser.retroactivity.RetroActivityFuture">
		    <action name="android.intent.action.MAIN" />
		    <extra name="ROM" value="$filePath" />
		    <extra name="LIBRETRO" value="$dataDir/cores/fceumm_libretro_android.so" />
		    <extra name="CONFIGFILE" value="/storage/emulated/0/RetroArch/data/retroarch.cfg" />
		  </intent>
	</folder>
	<exclusions>
		<folder name="m" />
		<folder name="r" />
		<folder name="u" />
	</exclusions>
</romulist>