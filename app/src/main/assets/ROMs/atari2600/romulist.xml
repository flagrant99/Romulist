<romulist>
	<folder name="Atari 2600 Retroarch core stella_libretro_android.so" extensions="a26, zip, bin">
		  <intent packageName="com.retroarch.aarch64" packageName32="com.retroarch.ra32" className="com.retroarch.browser.retroactivity.RetroActivityFuture">
		    <action name="android.intent.action.MAIN" />
		    <extra name="ROM" value="$FILE_PATH" />
		    <extra name="LIBRETRO" value="$dataDir/cores/stella_libretro_android.so" />
		    <extra name="CONFIGFILE" value="$EXTERNAL_FILES_DIR/retroarch.cfg" />
		  </intent>
	</folder>
	<exclusions>
		<folder name="m" />
		<folder name="r" />
		<folder name="u" />
	</exclusions>
</romulist>