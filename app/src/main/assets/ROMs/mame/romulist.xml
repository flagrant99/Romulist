<romulist>
	<folder name="Mame" extensions="zip" use_gamelistxml_names="Y">
		  <intent name="mame2003" packageName="com.retroarch.aarch64" packageName32="com.retroarch.ra32" className="com.retroarch.browser.retroactivity.RetroActivityFuture">
		    <action name="android.intent.action.MAIN" />
		    <extra name="ROM" value="$FILE_PATH" />
		    <extra name="LIBRETRO" value="$DATA_DIR/cores/mame2003_libretro_android.so" />
		    <extra name="CONFIGFILE" value="$EXTERNAL_FILES_DIR/retroarch.cfg" />
		  </intent>
		  <alt_intents>
		    <intent name="mame2003_plus" packageName="com.retroarch.aarch64" packageName32="com.retroarch.ra32" className="com.retroarch.browser.retroactivity.RetroActivityFuture">
		      <action name="android.intent.action.MAIN" />
		      <extra name="ROM" value="$FILE_PATH" />
		      <extra name="LIBRETRO" value="$DATA_DIR/cores/mame2003_plus_libretro_android.so" />
		      <extra name="CONFIGFILE" value="$EXTERNAL_FILES_DIR/retroarch.cfg" />
		    </intent>
		 </alt_intents>
		 <media>
			<cover type="relative" useSubfolder="true">../../ES-DE/downloaded_media/$PARENT_FOLDER_NAME/covers</cover>
			<marquee type="relative" useSubfolder="true">../../ES-DE/downloaded_media/$PARENT_FOLDER_NAME/marquees</marquee>
			<mixart type="relative" useSubfolder="true">../../ES-DE/downloaded_media/$PARENT_FOLDER_NAME/miximages</mixart>
			<screen type="relative" useSubfolder="true">../../ES-DE/downloaded_media/$PARENT_FOLDER_NAME/screenshots</screen>
			<video type="relative" useSubfolder="true">../../ES-DE/downloaded_media/$PARENT_FOLDER_NAME/videos</video>
		 </media>
	</folder>
	<exclusions>
		<folder name="m" />
		<folder name="r" />
		<folder name="u" />
		<folder name="mame2003" />
	</exclusions>
</romulist>