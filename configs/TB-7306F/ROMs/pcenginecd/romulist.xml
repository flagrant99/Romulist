<romulist>
	<folder name="PC Engine CD" extensions="chd, cdi">
		  <intent name="mednafen_pce" packageName="com.retroarch.aarch64" packageName32="com.retroarch.ra32" className="com.retroarch.browser.retroactivity.RetroActivityFuture">
		    <action name="android.intent.action.MAIN" />
		    <extra name="ROM" value="$FILE_PATH" />
		    <extra name="LIBRETRO" value="$DATA_DIR/cores/mednafen_pce_libretro_android.so" />
		    <extra name="CONFIGFILE" value="$EXTERNAL_FILES_DIR/retroarch.cfg" />
		  </intent>
		 <media>
			<cover type="fixed">/storage/emulated/0/ROMs/pcenginecd/m/cover</cover>
			<marquee type="relative">m/marquee</marquee>
			<mixart type="relative">m/mixart</mixart>
			<screen type="relative">m/screen</screen>
			<video type="relative">m/video</video>
		 </media>
	</folder>
	<exclusions>
		<folder name="m" />
		<folder name="r" />
		<folder name="u" />
	</exclusions>
</romulist>