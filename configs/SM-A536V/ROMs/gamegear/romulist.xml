<romulist>
	<folder name="Game Gear" extensions="zip" use_gamelistxml_names="Y">
		  <intent name="genesis_plus_gx" packageName="com.retroarch.aarch64" packageName32="com.retroarch.ra32" className="com.retroarch.browser.retroactivity.RetroActivityFuture">
		    <action name="android.intent.action.MAIN" />
		    <extra name="ROM" value="$FILE_PATH" />
		    <extra name="LIBRETRO" value="$DATA_DIR/cores/genesis_plus_gx_libretro_android.so" />
		    <extra name="CONFIGFILE" value="$EXTERNAL_FILES_DIR/retroarch.cfg" />
		  </intent>
		  <alt_intents>
		    <intent name="picodrive" packageName="com.retroarch.aarch64" packageName32="com.retroarch.ra32" className="com.retroarch.browser.retroactivity.RetroActivityFuture">
		      <action name="android.intent.action.MAIN" />
		      <extra name="ROM" value="$FILE_PATH" />
		      <extra name="LIBRETRO" value="$DATA_DIR/cores/picodrive_libretro_android.so" />
		      <extra name="CONFIGFILE" value="$EXTERNAL_FILES_DIR/retroarch.cfg" />
		    </intent>
		    <intent name="genesis_plus_gx_wide" packageName="com.retroarch.aarch64" packageName32="com.retroarch.ra32" className="com.retroarch.browser.retroactivity.RetroActivityFuture">
		      <action name="android.intent.action.MAIN" />
		      <extra name="ROM" value="$FILE_PATH" />
		      <extra name="LIBRETRO" value="$DATA_DIR/cores/genesis_plus_gx_wide_libretro_android.so" />
		      <extra name="CONFIGFILE" value="$EXTERNAL_FILES_DIR/retroarch.cfg" />
		    </intent>
		 </alt_intents>
		 <media>
			<cover type="fixed" useSubfolder="true">/storage/emulated/0/ES-DE/downloaded_media/gamegear/covers</cover>
			<marquee type="fixed" useSubfolder="true">/storage/emulated/0/ES-DE/downloaded_media/gamegear/marquees</marquee>
			<mixart type="fixed" useSubfolder="true">/storage/emulated/0/ES-DE/downloaded_media/gamegear/miximages</mixart>
			<screen type="fixed" useSubfolder="true">/storage/emulated/0/ES-DE/downloaded_media/gamegear/screenshots</screen>
			<video type="fixed" useSubfolder="true">/storage/emulated/0/ES-DE/downloaded_media/gamegear/videos</video>
		 </media>
	</folder>
	<exclusions>
		<folder name="m" />
		<folder name="r" />
		<folder name="u" />
	</exclusions>
</romulist>