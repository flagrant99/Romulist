<romulist>
	<folder name="Colecovision" extensions="rom" use_gamelistxml_names="Y">
		  <intent name="gearcoleco" packageName="com.retroarch.aarch64" packageName32="com.retroarch.ra32" className="com.retroarch.browser.retroactivity.RetroActivityFuture">
		    <action name="android.intent.action.MAIN" />
		    <extra name="ROM" value="$FILE_PATH" />
		    <extra name="LIBRETRO" value="$DATA_DIR/cores/gearcoleco_libretro_android.so" />
		    <extra name="CONFIGFILE" value="$EXTERNAL_FILES_DIR/retroarch.cfg" />
		  </intent>
		 <media>
			<cover type="fixed" useSubfolder="true">/storage/emulated/0/ES-DE/downloaded_media/colecovision/covers</cover>
			<marquee type="fixed" useSubfolder="true">/storage/emulated/0/ES-DE/downloaded_media/colecovision/marquees</marquee>
			<mixart type="fixed" useSubfolder="true">/storage/emulated/0/ES-DE/downloaded_media/colecovision/miximages</mixart>
			<screen type="fixed" useSubfolder="true">/storage/emulated/0/ES-DE/downloaded_media/colecovision/screenshots</screen>
			<video type="fixed" useSubfolder="true">/storage/emulated/0/ES-DE/downloaded_media/colecovision/videos</video>
		 </media>
	</folder>
	<exclusions>
		<folder name="m" />
		<folder name="r" />
		<folder name="u" />
	</exclusions>
</romulist>